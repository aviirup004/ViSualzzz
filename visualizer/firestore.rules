rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /snapshots/{snapshotId} {
      
      // Allow public read access to fetch shared links
      allow read: if true;
      
      // Snapshots must be completely immutable
      allow update, delete: if false;
      
      // Strict schema validation for snapshot creation
      allow create: if 
        // 1. MUST contain exactly these 4 fields (no missing fields, no extra fields)
        request.resource.data.keys().hasAll(['codeSnippet', 'createdAt', 'environment', 'memoryHeapData']) &&
        request.resource.data.keys().hasOnly(['codeSnippet', 'createdAt', 'environment', 'memoryHeapData']) &&
        
        // 2. Data type validation
        request.resource.data.codeSnippet is string &&
        request.resource.data.environment is string;
    }
    
    // Explicitly deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
